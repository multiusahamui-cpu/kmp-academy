{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "constants.ts",
    "types.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "views/**/*.ts",
    "views/**/*.tsx"
  ],
  "exclude": ["backend-academy", "node_modules", "dist"]
}

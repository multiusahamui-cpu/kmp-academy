
PORT=5100
DATABASE_URL=postgresql://academy:PASSWORD@127.0.0.1:5432/garuda_academy
# Secret cookie sesi (wajib, acak, min. 32 karakter di produksi). Buat baru: openssl rand -hex 32
SESSION_SECRET=
# Redis untuk sesi. Pakai nomor DB khusus Academy agar terpisah dari digitalcoop.id.
REDIS_URL=redis://127.0.0.1:6379/5
NODE_ENV=development

# Origin lintas-situs yang diizinkan (pisahkan koma). Kosong = hanya same-origin lewat nginx.
ALLOWED_ORIGINS=https://academy.digitalcoop.id

# Jembatan identitas digitalcoop.id (server-ke-server, satu server). Kunci = ACADEMY_BRIDGE_KEY di .env digitalcoop.id
# (acak, min. 32 karakter: openssl rand -hex 32). URL = backend digitalcoop.id lokal.
DIGITALCOOP_BRIDGE_URL=http://127.0.0.1:5000
DIGITALCOOP_BRIDGE_KEY=

# Alat pengembangan lokal: tampilkan switcher role (tidak pernah aktif di build produksi)
VITE_SHOW_ROLE_SWITCHER=false

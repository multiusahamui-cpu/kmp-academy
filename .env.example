
PORT=5100
DATABASE_URL=postgresql://academy:PASSWORD@127.0.0.1:5432/garuda_academy
# Secret cookie sesi (wajib, acak, min. 32 karakter di produksi). Buat baru: openssl rand -hex 32
SESSION_SECRET=
# Redis untuk sesi. Pakai nomor DB khusus Academy agar terpisah dari digitalcoop.id.
REDIS_URL=redis://127.0.0.1:6379/5
NODE_ENV=development

# Origin lintas-situs yang diizinkan (pisahkan koma). Kosong = hanya same-origin lewat nginx.
ALLOWED_ORIGINS=https://academy.digitalcoop.id

# Jembatan identitas digitalcoop.id (server-ke-server, satu server). Kunci = ACADEMY_BRIDGE_KEY di .env digitalcoop.id
# (acak, min. 32 karakter: openssl rand -hex 32). URL = backend digitalcoop.id lokal.
DIGITALCOOP_BRIDGE_URL=http://127.0.0.1:5000
DIGITALCOOP_BRIDGE_KEY=

# Alat pengembangan lokal: tampilkan switcher role (tidak pernah aktif di build produksi)
VITE_SHOW_ROLE_SWITCHER=false

# Email keluar (kode verifikasi ganti email). Kosongkan bila belum dipakai: fitur ganti email nonaktif.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KMP-ADNG Academy <noreply@digitalcoop.id>
# SMTP_FROM_NAME=KMP-ADNG Academy   (opsional: nama pengirim; alamat tetap dari SMTP_FROM)
SMTP_SECURE=

# Cloudflare R2 (penyimpanan/CDN). Isi di .env, jangan di repo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE=
R2_PUBLIC_URL_BASE=
R2_PREFIX_KEY=

# Penyimpanan berkas: "local" (bawaan, folder static/ dan private-uploads/) atau "r2" (Cloudflare R2, butuh R2_* di atas).
STORAGE_DRIVER=local

# Pembayaran Virtual Account (Midtrans Core API). Kosongkan bila belum dipakai; saluran VA otomatis nonaktif.
# URL notifikasi di dashboard Midtrans: https://academy.digitalcoop.id/api/payments/midtrans/notify
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# KYC: kunci enkripsi NIK (64 hex). Buat: openssl rand -hex 32. Simpan terpisah dari cadangan database.
KYC_ENCRYPTION_KEY=

# Program Node (modul node/bonus terpisah). "true" mengaktifkan mode simulasi staging:
# pembuatan pesanan uji & pengajuan pencairan bonus tanpa uang sungguhan. Kosong/false = nonaktif.
# Catatan: fitur baru berfungsi setelah ada baris academy_node.rule_versions berstatus ACTIVE/DRAFT.
NODE_SIMULATION_MODE=false

# Materi PPT/PPTX dikonversi ke PDF di server memakai LibreOffice (biner "soffice").
# Pasang di server: apt-get install -y libreoffice  (atau libreoffice-impress minimal).
# Opsional set path biner bila tidak di PATH:
# SOFFICE_BIN=/usr/bin/soffice
